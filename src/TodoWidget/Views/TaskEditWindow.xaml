<Window x:Class="TodoWidget.Views.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办清单"
        Width="330"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="HeadingText"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="16,2,16,16">

                <TextBlock Text="任务"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="2,0,0,5" />
                <TextBox x:Name="TitleBox"
                         Style="{StaticResource FlatTextBox}"
                         Height="32"
                         MaxLength="120" />
                <TextBlock x:Name="ErrorText"
                           FontSize="11"
                           Foreground="#E03131"
                           Margin="2,5,0,0"
                           Visibility="Collapsed" />

                <TextBlock Text="截止时间（精确到小时）"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="2,14,0,5" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="78" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{StaticResource SurfaceBrush}">
                        <DatePicker x:Name="DateBox"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    FontSize="12.5"
                                    VerticalContentAlignment="Center"
                                    Padding="6,0,2,0"
                                    Height="30" />
                    </Border>

                    <Border Grid.Column="2"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{StaticResource SurfaceBrush}">
                        <ComboBox x:Name="HourBox"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  FontSize="12.5"
                                  VerticalContentAlignment="Center"
                                  Height="30" />
                    </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="取消"
                            Style="{StaticResource GhostButton}"
                            Click="Cancel_Click"
                            Margin="0,0,8,0" />
                    <Button Content="保存"
                            Style="{StaticResource PrimaryButton}"
                            Click="Save_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
