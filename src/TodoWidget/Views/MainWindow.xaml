<Window x:Class="TodoWidget.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TodoWidget.Converters"
        Title="待办清单"
        Width="420"
        Height="470"
        MinWidth="330"
        MinHeight="240"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        WindowStartupLocation="Manual"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:DoneStrikethroughConverter x:Key="Strike" />

        <!-- ============================================================ 折叠按钮 -->
        <!-- 左上角那个黑方块。视觉上还是 8×8 的小方块，但点击热区放大到 18×18，
              否则这么小的目标很难点中。折叠后同一个控件负责展开。
              刻意不用 Button：Button 会把 MouseLeftButtonDown 吞掉，导致
              "长按方块拖窗口"根本没法实现。这里用 Border，点击 / 拖动统一由
              Header_MouseLeftButtonDown + EndDrag 按有没有移动过来区分。 -->
        <Style x:Key="SquareDot" TargetType="Border">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Tag" Value="collapse-dot" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 方块本体。Border 的样式没法注入子元素，所以这 8×8 的小方块必须
             显式写在每个用它的地方（用这个样式，省得两处不一致）。
             IsHitTestVisible=False 让命中目标始终是外层 18×18 热区。 -->
        <Style x:Key="SquareDotMark" TargetType="Border">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- ============================================================ 锁定开关 -->
        <!-- 黑 = 锁定（置顶常驻）；白 = 解锁（只贴在桌面，会被其他窗口遮挡）。
             轨道刻意不用 Border：CornerRadius 正好等于高度一半（胶囊形）时，WPF 会把
             1.2px 的边框渲染成虚线，黑色态下虚线的缝隙会露出白底，看起来像"白色痕迹"。
             改成纯色填充后黑态就只剩一个干净的白色圆点。 -->
        <Style x:Key="LockSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="track"
                                    CornerRadius="9"
                                    Background="{StaticResource BorderStrongBrush}" />
                            <Border x:Name="knob"
                                    Width="12"
                                    Height="12"
                                    CornerRadius="6"
                                    Background="{StaticResource SurfaceBrush}"
                                    HorizontalAlignment="Left"
                                    Margin="3,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Hover changes the track colour instead of the control opacity,
                                 so the locked state stays pure black while the pointer is on it. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#C3C3C9" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="knob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="track" Property="Background" Value="#3F3F46" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ 作者入口 -->
        <!-- 灰色小字，放在锁定开关左边；点一下才弹小框，避免误触直接开浏览器。 -->
        <Style x:Key="AuthorLinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="5,3">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupItemButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="10,7">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ task row -->
        <!-- 格式：【颜色方块】【任务】：【截止时间 yyyy-MM-dd HH】【剩余时间】【打勾】 -->
        <DataTemplate x:Key="TaskRowTemplate">
            <Border x:Name="row"
                    CornerRadius="7"
                    Background="Transparent"
                    Padding="7,7,5,7"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 紧急程度方块 -->
                    <Border Grid.Column="0"
                            Width="9"
                            Height="9"
                            CornerRadius="2.5"
                            Background="{Binding SquareBrush}"
                            VerticalAlignment="Center"
                            Margin="3,0,8,0" />

                    <!-- 一整行：任务：截止时间 剩余时间
                         用单个 TextBlock 承载，文字才会左贴而不是被列宽撑散。 -->
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextDecorations="{Binding IsDone, Converter={StaticResource Strike}}"><Run Text="{Binding Title, Mode=OneWay}" FontSize="12.5" Foreground="{StaticResource TextBrush}" /><Run Text="：" FontSize="12" Foreground="{StaticResource TextFaintBrush}" /><Run Text="{Binding DueText, Mode=OneWay}" FontSize="11.5" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}" /><Run Text="  " FontSize="11.5" /><Run Text="{Binding RemainingText, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" /></TextBlock>

                    <!-- 悬停才出现的编辑 / 删除 -->
                    <StackPanel x:Name="actions"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Opacity="0"
                                Margin="6,0,2,0">
                        <Button Style="{StaticResource GlyphButton}"
                                Tag="{StaticResource IconEdit}"
                                Command="{Binding EditCommand}"
                                ToolTip="编辑"
                                Margin="0,0,1,0" />
                        <Button Style="{StaticResource GlyphButton}"
                                Tag="{StaticResource IconTrash}"
                                Command="{Binding DeleteCommand}"
                                ToolTip="删除" />
                    </StackPanel>

                    <!-- 打勾：OneWay + Command，避免双向绑定把默认值回写进模型 -->
                    <CheckBox Grid.Column="3"
                              Style="{StaticResource TickBox}"
                              IsChecked="{Binding IsDone, Mode=OneWay}"
                              Command="{Binding ToggleCommand}"
                              VerticalAlignment="Center"
                              Margin="6,0,3,0" />
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{StaticResource HoverBrush}" />
                    <Setter TargetName="actions" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- DWM rounds the real window on Windows 11; this border supplies the hairline. -->
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}">
        <Grid>

            <!-- ================================================ 折叠后的小标签 -->
            <!-- 点左上角黑方块收起；同一个方块再点一次展开。整体也是拖动热区。
                 Visibility 不绑定，由代码配合动画控制，否则内容会瞬间切换、动画没法淡入淡出。 -->
            <Grid x:Name="CollapsedRoot"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <!-- 左下角对齐、margin 与展开态标题栏完全一致，这样黑方块在两种状态下
                     落在同一个像素上，折叠时不会位移。 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <Border Style="{StaticResource SquareDot}"
                            ToolTip="{Binding CollapseTooltip}">
                        <Border Style="{StaticResource SquareDotMark}" />
                    </Border>
                    <!-- 最紧急那条的颜色，折叠时也能一眼看出紧不紧急 -->
                    <Border Width="8"
                            Height="8"
                            CornerRadius="2"
                            Background="{Binding MostUrgentBrush}"
                            VerticalAlignment="Center"
                            Margin="2,0,0,0" />
                    <TextBlock FontSize="11.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="7,0,0,0"><Run Text="待完成 " /><Run Text="{Binding ActiveCount, Mode=OneWay}" /></TextBlock>
                </StackPanel>
            </Grid>

            <!-- ================================================ 展开后的完整界面 -->
            <Grid x:Name="ExpandedRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- ==================================================== header -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 用 Grid 而不是 StackPanel：窄窗口时"更新于 …"可以省略号截断，
                     加了作者入口之后右侧变宽，StackPanel 会直接溢出。 -->
                <Grid Grid.Column="0" Margin="10,0,0,0" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- 左上角黑方块：点一下折叠；按住拖动则移动窗口 -->
                    <Border Grid.Column="0"
                            Style="{StaticResource SquareDot}"
                            ToolTip="{Binding CollapseTooltip}"
                            VerticalAlignment="Center">
                        <Border Style="{StaticResource SquareDotMark}" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="待办清单"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="2,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding LastRefreshText}"
                               FontSize="10.5"
                               Foreground="{StaticResource TextFaintBrush}"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0">
                    <Button x:Name="AuthorLink"
                            Style="{StaticResource AuthorLinkButton}"
                            Content="Bug反馈与作者"
                            Click="AuthorLink_Click"
                            ToolTip="联系作者 / 反馈问题"
                            Margin="0,0,2,0" />

                    <!-- 锁定开关：黑=置顶常驻，白=只贴桌面。
                         与打勾框同理，用 OneWay + Command，避免双向绑定回写默认值。 -->
                    <ToggleButton x:Name="LockToggle"
                                  Style="{StaticResource LockSwitchStyle}"
                                  IsChecked="{Binding IsLocked, Mode=OneWay}"
                                  Command="{Binding ToggleLockCommand}"
                                  ToolTip="{Binding LockTooltip}"
                                  Margin="0,0,11,0" />
                    <Button Style="{StaticResource GlyphButton}"
                            Tag="{StaticResource IconPlus}"
                            Command="{Binding AddCommand}"
                            ToolTip="添加任务"
                            Margin="0,0,2,0" />
                    <Button Style="{StaticResource GlyphButton}"
                            Tag="{StaticResource IconRefresh}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="刷新"
                            Margin="0,0,2,0" />
                    <Button Style="{StaticResource GlyphButton}"
                            Tag="{StaticResource IconClose}"
                            Click="HideToTray_Click"
                            ToolTip="隐藏到托盘（在托盘菜单里退出）" />
                </StackPanel>

                <!-- 点"Bug反馈与作者"弹出的小框；StaysOpen=false 时点外面自动收起。 -->
                <Popup x:Name="AuthorPopup"
                       PlacementTarget="{Binding ElementName=AuthorLink}"
                       Placement="Bottom"
                       HorizontalOffset="-8"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="5"
                            Margin="0,6,10,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.18" Color="#000000" />
                        </Border.Effect>
                        <StackPanel MinWidth="152">
                            <Button Style="{StaticResource PopupItemButton}"
                                    Content="访问作者 Github"
                                    Click="Github_Click" />
                            <TextBlock Text="{Binding AuthorHomepageLabel}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       Margin="10,0,10,5" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- ==================================================== tabs -->
            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="8,1,8,3">
                    <RadioButton Style="{StaticResource TabButton}" GroupName="Pages"
                                 IsChecked="{Binding IsActivePage, Mode=OneWay}"
                                 Command="{Binding ShowActiveCommand}">
                        <TextBlock><Run Text="待完成 " /><Run Text="{Binding ActiveCount, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource TabButton}" GroupName="Pages"
                                 IsChecked="{Binding IsDonePage, Mode=OneWay}"
                                 Command="{Binding ShowDoneCommand}">
                        <TextBlock><Run Text="已完成 " /><Run Text="{Binding DoneCount, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource TabButton}" GroupName="Pages"
                                 IsChecked="{Binding IsOverduePage, Mode=OneWay}"
                                 Command="{Binding ShowOverdueCommand}">
                        <TextBlock><Run Text="超时 " /><Run Text="{Binding OverdueCount, Mode=OneWay}" /></TextBlock>
                    </RadioButton>

                    <Button x:Name="ClearButton"
                            Style="{StaticResource GlyphButton}"
                            Tag="{StaticResource IconTrash}"
                            HorizontalAlignment="Right"
                            Margin="10,0,0,0"
                            Click="ClearCurrentPage_Click"
                            ToolTip="清空当前页面"
                            Visibility="{Binding IsActivePage, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                </StackPanel>
            </Border>

            <!-- ==================================================== pages -->
            <Grid Grid.Row="2">

                <!-- 待完成 -->
                <Grid Visibility="{Binding IsActivePage, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,6,4,8">
                        <ItemsControl ItemsSource="{Binding ActiveTasks}" ItemTemplate="{StaticResource TaskRowTemplate}" />
                    </ScrollViewer>
                    <TextBlock Text="暂无待办事项"
                               FontSize="12"
                               Foreground="{StaticResource TextFaintBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsActiveEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- 已完成 -->
                <Grid Visibility="{Binding IsDonePage, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,6,4,8">
                        <ItemsControl ItemsSource="{Binding DoneTasks}" ItemTemplate="{StaticResource TaskRowTemplate}" />
                    </ScrollViewer>
                    <TextBlock Text="还没有已完成的事项"
                               FontSize="12"
                               Foreground="{StaticResource TextFaintBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsDoneEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- 超时 -->
                <Grid Visibility="{Binding IsOverduePage, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,6,4,8">
                        <ItemsControl ItemsSource="{Binding OverdueTasks}" ItemTemplate="{StaticResource TaskRowTemplate}" />
                    </ScrollViewer>
                    <TextBlock Text="没有超时事项"
                               FontSize="12"
                               Foreground="{StaticResource TextFaintBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsOverdueEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>

            <!-- ==================================================== footer -->
            <Border Grid.Row="3"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{StaticResource SurfaceAltBrush}">
                <Grid>
                    <TextBlock FontSize="10.5"
                               Foreground="{StaticResource TextFaintBrush}"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0">
                        <Run Text="待完成 " /><Run Text="{Binding ActiveCount, Mode=OneWay}" />
                        <Run Text=" · 已完成 " /><Run Text="{Binding DoneCount, Mode=OneWay}" />
                        <Run Text=" · 超时 " /><Run Text="{Binding OverdueCount, Mode=OneWay}" />
                    </TextBlock>

                    <!-- 拖这里改变占用大小 -->
                    <Thumb x:Name="ResizeGrip"
                           Width="18"
                           Height="18"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Cursor="SizeNWSE"
                           DragStarted="Grip_DragStarted"
                           DragDelta="Grip_DragDelta"
                           DragCompleted="Grip_DragCompleted">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent" ToolTip="拖动改变大小">
                                    <Path Stroke="{StaticResource TextFaintBrush}"
                                          StrokeThickness="1.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M 12,5 L 5,12 M 12,10 L 10,12" />
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Border>
            </Grid>
            <!-- ==================================== /展开后的完整界面 -->

            <!-- 展开态点这里收起 -->
        </Grid>
    </Border>
</Window>
